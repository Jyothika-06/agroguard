# OpenWeatherMap API Key for live weather forecasting.
# AgroGuard automatically loads this file via python-dotenv on application startup.
# If unset or blank, AgroGuard automatically falls back to realistic mock weather data.
AGROGUARD_WEATHER_API_KEY=your_openweather_api_key_here

# Optional: Target city for weather forecast (defaults to Vellore if unset)
AGROGUARD_CITY=your_city_here

